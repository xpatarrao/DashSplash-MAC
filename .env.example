# DashSplash MAC — local configuration
# Copy to `.env` and fill in your real values. `.env` is gitignored (never pushed).
# All of these are optional — defaults below make the dashboard work out of the box
# if your Splash/macmon happen to listen on 127.0.0.1.

# Source endpoints (where Splash and macmon publish)
DASHSPLASH_SPLASH_URL=http://127.0.0.1:8000/metrics
DASHSPLASH_MACMON_URL=http://127.0.0.1:9090/json
DASHSPLASH_OLLAMA_URL=http://127.0.0.1:11434/api/ps   # optional (loaded models)

# Display / hardware
DASHSPLASH_MODEL=Qwen3.8-27B-4bit
DASHSPLASH_GPU_TDP=100          # GPU TDP in watts (for power/efficiency calc)
DASHSPLASH_MEM_GB=64            # total unified memory in GB (cosmetic title only; the free/bar use macmon's real RAM)
DASHSPLASH_NODE_NAME="Mac Mini M5 Pro"
DASHSPLASH_NODE_IP=192.168.1.x  # cosmetic badge only

# Dashboard port
DASHSPLASH_PORT=8081
